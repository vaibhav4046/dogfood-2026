{
  "name": "dogfood-2026",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first hackathon submission and judging platform (DOGFOOD 2026)",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.js\"",
    "test:unit": "node --test --test-reporter=spec \"tests/unit/*.test.js\"",
    "test:integration": "node --test --test-reporter=spec \"tests/integration/*.test.js\"",
    "test:authz": "node --test --test-reporter=spec \"tests/authz/*.test.js\"",
    "test:accept": "node --test --test-reporter=spec \"tests/acceptance/*.test.js\"",
    "smoke": "node scripts/smoke.mjs",
    "acceptance": "python official/run.py .dogfood.toml"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "express": "4.21.2"
  }
}
